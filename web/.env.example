# Backend base URL. Local backend by default; set it to the Space/Cloud Run URL
# in the Cloudflare Pages project settings.
VITE_API_URL=http://localhost:8080

# Optional: enable the Turnstile widget on the generate button. Leave empty and
# the widget is skipped entirely (the API only enforces it if its own secret is set).
VITE_TURNSTILE_SITE_KEY=
