# --- Supabase (leave empty to run locally on SQLite + ./.data) ---
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_BUCKET=generations

# --- Retention: 48h, shortened to 24h after the first download ---
RETENTION_HOURS=48
POST_DOWNLOAD_HOURS=24
CLEANUP_TOKEN=change-me

# --- Limits ---
MAX_UPLOAD_BYTES=12582912
MAX_IMAGE_PIXELS=40000000
# Quota: contata sulle righe di generations, non in memoria
QUOTA_ANON_DAILY=2
QUOTA_USER_DAILY=5
QUOTA_WINDOW_H=24
QUOTA_ANON_IP_DAILY=10
ANON_MAX_RES_CAP=800
ANON_MAX_DIM_MM=200
IP_HASH_SALT=change-me

# --- Queue ---
MAX_WORKERS=1
MAX_QUEUE=8
JOB_TIMEOUT_S=600

# --- Frontend origins (phase 2) ---
CORS_ORIGINS=*
